@{
    ViewData["Title"] = "Welcome to RecoBox";
}

<div class="container d-flex flex-column justify-content-center align-items-center" style="min-height: 75vh;">
    <h1 class="display-4 fw-bold mb-4 text-center">Welcome to <span class="text-primary">RecoBox</span></h1>
    <p class="lead text-muted text-center mb-5">Get smart recommendations for Movies and Products – or let us surprise you!</p>

    <div class="row text-center w-100 px-3">
        <div class="col-md-4 mb-3">
            <a href="/Home/Movies" class="btn btn-primary btn-lg w-100 py-3">Movie Recommendations</a>
        </div>
        <div class="col-md-4 mb-3">
            <a href="/Home/Products" class="btn btn-success btn-lg w-100 py-3">Product Recommendations</a>
        </div>
        <div class="col-md-4 mb-3">
            <a href="/Home/Surprise" class="btn btn-warning btn-lg w-100 py-3">Surprise Me</a>
        </div>
    </div>
</div>
